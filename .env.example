# Скопируй в .env и заполни.
#
# Используется напрямую приложением (web.app + bot.main через python-dotenv).
# Скрипт deploy/setup.sh принимает те же переменные из окружения и сам
# создаёт .env при первом деплое.

# ── Обязательные ────────────────────────────────────────────────────

# Telegram-бот (BotFather -> /newbot). Если бот не нужен — можно
# поставить заглушку, сервис запустится но будет крашиться.
BOT_TOKEN=your_telegram_bot_token

# URL твоей SA-MP веб-платформы, к которой клиент подключается через WS.
# Пример: http://pawn.your-platform.com:2540/
PLATFORM_URL=http://your-platform-host:port/

# ── Опциональные (с дефолтами) ──────────────────────────────────────

# SOCKS5 прокси для исходящих коннектов к платформе и БД.
# Дефолт — локальный xray на 10808 (поднимается setup.sh).
# PROXY_URL=socks5://127.0.0.1:10808

# ── Только для deploy/setup.sh, в .env не нужны ─────────────────────
# Эти переменные читает СКРИПТ установки, в .env приложения не идут:
#
#   DOMAIN=code.kusehsup.ru
#   EMAIL=admin@example.com
#   APP_DIR=/opt/custom-platform
#   WEB_PORT=8002
#   NGINX_PORT=8001
#   GITHUB_REPO=https://github.com/...
#
# XRAY_VLESS — vless:// ссылка из v2RayNG / Streisand / Hiddify.
# Если задана — setup.sh сгенерирует /etc/xray/config.json и запустит
# xray. Если нет — xray-шаг пропускается, поднимаем без туннеля.
# Пример:
#   XRAY_VLESS="vless://uuid@host:443?security=reality&pbk=...&sni=google.com&fp=chrome&flow=xtls-rprx-vision&type=tcp"
